# Supabase: Project Settings > Data API (URL) e Project Settings > API Keys (chave).
# Use a publishable key (sb_publishable_...) ou a anon legada (eyJ...). Nunca a secret/service_role.
# Sem estas variáveis o site roda em modo demonstração.
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE
