---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import Illustration from '../components/Illustration.astro';
import balcao from '../assets/sobre/balcao.jpg';
import maos from '../assets/sobre/maos.jpg';
import fornada from '../assets/sobre/fornada.jpg';
import '../styles/cart.css';

const jeito = [
  {
    titulo: 'Massa de 12 horas',
    texto:
      'A massa do sonho descansa a noite inteira na geladeira. Fermentação lenta dá miolo leve, que não pesa nem encharca de óleo.',
    foto: maos,
    alt: 'Mãos sovando a massa numa tigela, com farinha na bancada',
  },
  {
    titulo: 'Recheio na hora',
    texto:
      'O sonho só ganha recheio quando você chega ou quando o pedido vai sair. Por isso a casca continua crocante e o creme, gelado.',
  },
  {
    titulo: 'Fornada o dia todo',
    texto:
      'Pão de queijo de hora em hora, croissant três vezes por dia e pão de leite de manhã e de tarde. A vitrine mostra a próxima fornada.',
    foto: fornada,
    alt: 'Pães e roscas saindo do forno de azulejo',
  },
];

const equipe = [
  { nome: 'Rita', papel: 'Confeiteira', fala: 'Faz o doce de leite no tacho toda terça.', cor: '#f7b4c8' },
  { nome: 'Joel', papel: 'Padeiro', fala: 'Chega às 4h para a primeira fornada.', cor: '#ffd23f' },
  { nome: 'Tati', papel: 'Balcão', fala: 'Sabe de cor o pedido de metade do bairro.', cor: '#fde6d8' },
  { nome: 'Caio', papel: 'Entregas', fala: 'Conhece todos os atalhos da Vila Madalena.', cor: '#e7b46d' },
];
---

<Base
  title="Sobre a Bendita · Doceria e padaria na Vila Madalena"
  description="A história da Bendita: o sonho da vó Benedita, massa de fermentação lenta e recheio na hora, na Vila Madalena."
>
  <Header home={false} current="/sobre" />

  <main id="conteudo">
    <section class="intro wrap">
      <div class="intro-copy">
        <p class="eyebrow">Sobre a Bendita</p>
        <h1>Um sonho de família, recheado na hora desde 2019.</h1>
        <p class="lead">
          A Bendita começou com o caderno de receitas da vó Benedita e uma vitrine pequena na Rua Harmonia. A
          ideia era simples: fazer o sonho que a gente comia criança, com massa descansada e recheio de verdade, e
          vender ainda quente.
        </p>
        <div class="actions">
          <a class="btn btn-dark" href="/#vitrine">Ver a vitrine</a>
          <a class="btn btn-light" href="/#festa">Encomendar para festa</a>
        </div>
      </div>
      <figure class="intro-photo">
        <Image
          src={balcao}
          alt="Vitrine de madeira e vidro com doces da padaria"
          widths={[360, 540, 720]}
          sizes="(max-width: 820px) 80vw, 380px"
          loading="eager"
          fetchpriority="high"
        />
        <Illustration art="sonho" tint="#ffd23f" class="intro-sticker" />
      </figure>
    </section>

    <section class="historia section" aria-labelledby="historia-titulo">
      <div class="wrap narrow">
        <h2 id="historia-titulo">Por que “Bendita”</h2>
        <p>
          Benedita fazia sonho aos domingos para a família inteira, numa panela de ferro que ainda está na cozinha da
          padaria. Quando a neta, Rita, resolveu abrir uma doceria, o nome veio antes do cardápio: Bendita, de
          Benedita e do primeiro comentário de quem provou.
        </p>
        <p>
          Hoje são quatro pessoas no balcão e na cozinha, 18 itens na vitrine e um único combinado: o que acabar, só
          amanhã. A gente prefere esgotar a vender sonho do dia anterior.
        </p>
      </div>
    </section>

    <section class="jeito section" aria-labelledby="jeito-titulo">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Do nosso jeito</p>
          <h2 id="jeito-titulo">Três regras da cozinha</h2>
        </div>
        <ol class="regras" role="list">
          {
            jeito.map((r, i) => (
              <li class:list={['regra', { 'com-foto': r.foto }]}>
                {r.foto && (
                  <Image src={r.foto} alt={r.alt!} widths={[360, 540, 720]} sizes="(max-width: 820px) 90vw, 360px" class="regra-foto" />
                )}
                <div class="regra-texto">
                  <span class="num" aria-hidden="true">{i + 1}</span>
                  <h3>{r.titulo}</h3>
                  <p>{r.texto}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="equipe section" aria-labelledby="equipe-titulo">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Quem faz</p>
          <h2 id="equipe-titulo">A turma da Bendita</h2>
        </div>
        <ul class="pessoas" role="list">
          {
            equipe.map((p) => (
              <li>
                <span class="avatar" style={`background:${p.cor}`} aria-hidden="true">
                  {p.nome[0]}
                </span>
                <h3>{p.nome}</h3>
                <p class="papel">{p.papel}</p>
                <p>{p.fala}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />
  <CartDrawer />
</Base>

<script>
  import '../scripts/cart-ui';
</script>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(32px, 6vw, 72px);
  }

  .intro-copy {
    display: grid;
    gap: 18px;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1;
  }

  .lead {
    max-width: 52ch;
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .intro-photo {
    position: relative;
    margin: 0;
    justify-self: center;
    width: min(100%, 380px);
  }

  .intro-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 24px;
    box-shadow: 0 0 0 3px var(--brigadeiro), 10px 12px 0 var(--brigadeiro);
    transform: rotate(2deg);
  }

  .intro-photo :global(.intro-sticker) {
    position: absolute;
    left: -12%;
    bottom: -6%;
    width: 42%;
    transform: rotate(-10deg);
  }

  .historia {
    background: var(--glace);
  }

  .narrow {
    max-width: 720px;
    display: grid;
    gap: 16px;
    font-size: 1.125rem;
  }

  .regras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }

  .regra {
    display: grid;
    gap: 14px;
    padding: 16px;
    background: var(--branco);
    border-radius: var(--radius-m);
    box-shadow: 0 0 0 3px var(--brigadeiro), 6px 8px 0 var(--brigadeiro);
  }

  .regra:not(.com-foto) {
    background: var(--creme);
    align-self: center;
  }

  .regra :global(.regra-foto) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }

  .regra-texto {
    display: grid;
    gap: 6px;
  }

  .num {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--brigadeiro);
    color: var(--creme);
    font-family: var(--display);
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 800;
  }

  .pessoas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }

  .pessoas li {
    display: grid;
    gap: 6px;
    justify-items: start;
    padding: 18px;
    border-radius: var(--radius-m);
    background: var(--acucar-2);
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--brigadeiro);
    font-family: var(--display);
    font-size: 1.5rem;
  }

  .papel {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brigadeiro-2);
  }

  @media (max-width: 820px) {
    .intro {
      grid-template-columns: 1fr;
    }

    .regras {
      grid-template-columns: 1fr;
    }
  }
</style>
