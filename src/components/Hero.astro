---
import { Image } from 'astro:assets';
import { PHOTOS } from '../data/photos';
import Illustration from './Illustration.astro';

const CARDS = [
  {
    pos: 'left',
    foto: 'pote-morango',
    alt: 'Bolo de pote de morango em camadas num pote de vidro, com uma colher ao lado',
  },
  {
    pos: 'right',
    foto: 'pao-de-queijo',
    alt: 'Pães de queijo dourados saindo do forno',
  },
  {
    pos: 'front',
    foto: 'sonho-doce-de-leite',
    label: 'sonho na hora',
    alt: 'Mão mergulhando um sonho no doce de leite, com outros sonhos açucarados no prato',
  },
] as const;
---

<section id="topo" class="hero-section">
  <div class="wrap">
    <div class="hero">
      <div class="copy">
        <p class="eyebrow">Doceria e padaria · Vila Madalena</p>
        <h1>Sonho recheado <span class="hl">na hora</span>, do jeito que você pedir.</h1>
        <p class="lead">
          Massa de fermentação lenta, recheio feito aqui e açúcar sem economia. Monte sua sacola, escolha o horário
          e retire no balcão ainda quentinho.
        </p>
        <div class="actions">
          <a class="btn btn-dark" href="#vitrine">Ver a vitrine</a>
          <a class="btn btn-light" href="#festa">Encomendar para festa</a>
        </div>
      </div>

      <!-- A shop-window spread: three cards fanned out, the sonho in front. -->
      <div class="art">
        {
          CARDS.map((c) => (
            <figure class={`card card-${c.pos}`}>
              <Image
                src={PHOTOS[c.foto]}
                alt={c.alt}
                widths={c.pos === 'front' ? [320, 480, 640] : [220, 330, 440]}
                sizes={c.pos === 'front' ? '(max-width: 820px) 220px, 300px' : '(max-width: 820px) 150px, 200px'}
                loading="eager"
                fetchpriority={c.pos === 'front' ? 'high' : 'auto'}
              />
              {c.pos === 'front' && <figcaption>{c.label}</figcaption>}
            </figure>
          ))
        }
        <Illustration art="sonho" tint="#ffd23f" class="art-sonho" />
      </div>

      <p class="sticker" data-batch>
        Pão de queijo saindo de hora em hora
      </p>
    </div>
  </div>
</section>

<script>
  import { MENU } from '../data/menu';
  import { nextBatch } from '../scripts/fornadas';

  // Same batches as the pão de queijo card in the vitrine.
  const el = document.querySelector<HTMLElement>('[data-batch]');
  const hours = MENU.find((p) => p.id === 'pao-de-queijo')?.fornadas ?? [];
  const next = nextBatch(hours, new Date());
  if (el && next) {
    el.textContent =
      next.daysAhead === 0
        ? `Próxima fornada de pão de queijo: ${next.hour}h`
        : `Pão de queijo de novo ${next.daysAhead === 1 ? 'amanhã' : 'na terça'} às ${next.hour}h`;
  }
</script>

<style>
  .hero-section {
    padding-block: 12px clamp(40px, 6vw, 72px);
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding: clamp(28px, 5vw, 64px);
    background: var(--glace);
    border-radius: var(--radius-l);
  }

  .copy {
    display: grid;
    gap: 20px;
    min-width: 0;
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    line-height: 0.98;
  }

  /* Gradient instead of a solid box: Bagel's tall ascent would cover the line above. */
  .hl {
    background: linear-gradient(transparent 22%, var(--creme) 22%, var(--creme) 94%, transparent 94%);
    padding: 0 0.08em;
    border-radius: 0.2em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .lead {
    max-width: 46ch;
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .art {
    position: relative;
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1.02;
    justify-self: center;
  }

  /* Instant-photo cards: white border, thick outline, hard shadow, a label at the foot. */
  .card {
    position: absolute;
    margin: 0;
    padding: 10px 10px 28px;
    background: var(--branco);
    border-radius: 18px;
    box-shadow: 0 0 0 3px var(--brigadeiro), 8px 10px 0 var(--brigadeiro);
  }

  .card :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    background: var(--glace-2);
  }

  .card figcaption {
    padding: 8px 4px 10px;
    text-align: center;
    font-weight: 800;
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.02em;
  }

  .card-left {
    width: 44%;
    left: 0;
    top: 4%;
    --r: -9deg;
    transform: rotate(var(--r));
  }

  .card-right {
    width: 44%;
    right: 0;
    top: 0;
    --r: 8deg;
    transform: rotate(var(--r));
  }

  .card-front {
    width: 60%;
    left: 21%;
    top: 20%;
    z-index: 1;
    --r: 2deg;
    transform: rotate(var(--r));
  }

  .card-front {
    padding-bottom: 0;
  }

  .card-front figcaption {
    background: var(--creme);
    border-radius: 999px;
    margin: 8px auto 10px;
    padding: 4px 14px;
    width: fit-content;
  }

  /* The illustrated sonho is a sticker slapped on the front card. */
  .art :global(.art-sonho) {
    position: absolute;
    z-index: 2;
    width: 30%;
    left: 6%;
    bottom: 0;
    transform: rotate(-12deg);
  }

  .sticker {
    position: absolute;
    left: clamp(20px, 5vw, 64px);
    bottom: -20px;
    transform: rotate(-3deg);
    background: var(--brigadeiro);
    color: var(--creme);
    font-weight: 800;
    padding: 10px 18px;
    border-radius: 999px;
    max-width: calc(100% - 40px);
  }

  /* Load sequence: text rises, the marker sweeps under "na hora", the sonho drops
     into the plate, the pão de queijo pops, then the sticker is slapped on. */
  @media (prefers-reduced-motion: no-preference) {
    .eyebrow,
    h1,
    .lead,
    .actions {
      animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    h1 {
      animation-delay: 0.06s;
    }

    .lead {
      animation-delay: 0.14s;
    }

    .actions {
      animation-delay: 0.22s;
    }

    .hl {
      background-repeat: no-repeat;
      background-size: 100% 100%;
      animation: marker 0.55s cubic-bezier(0.65, 0, 0.35, 1) 0.55s backwards;
    }

    .art {
      animation: float 6s ease-in-out 1.6s infinite;
    }

    /* Cards are dealt one by one, back to front. */
    .card {
      animation: deal 0.7s cubic-bezier(0.34, 1.4, 0.64, 1) backwards;
    }

    .card-left {
      animation-delay: 0.1s;
    }

    .card-right {
      animation-delay: 0.22s;
    }

    .card-front {
      animation-delay: 0.36s;
    }

    .card:hover {
      transform: rotate(0deg) translateY(-6px);
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .art :global(.art-sonho) {
      animation: pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s backwards;
    }

    .sticker {
      animation: slap 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 1s backwards;
    }

    .sticker:hover {
      transform: rotate(2deg) scale(1.03);
      transition: transform 0.2s ease;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes marker {
    from {
      background-size: 0% 100%;
    }
  }

  @keyframes deal {
    from {
      opacity: 0;
      transform: translateY(40px) rotate(calc(var(--r) * -2)) scale(0.85);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0) rotate(-30deg);
    }
  }

  @keyframes slap {
    from {
      opacity: 0;
      transform: rotate(-12deg) scale(1.3);
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 460px) {
    .sticker {
      font-size: 0.8125rem;
      padding: 8px 14px;
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      padding-bottom: 56px;
    }

    .art {
      max-width: 360px;
      width: 100%;
      justify-self: center;
      margin-top: 8px;
    }
  }
</style>
