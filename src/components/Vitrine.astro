---
import { CATEGORIES, COMBO_DISCOUNT, MENU, formatBRL } from '../data/menu';
import { Image } from 'astro:assets';
import { PHOTOS } from '../data/photos';
import Illustration from './Illustration.astro';
import Combo from './Combo.astro';

const tiles = ['var(--glace-2)', 'var(--acucar-2)', '#ffe9a3'];
---

<section id="vitrine" class="section" aria-labelledby="vitrine-titulo">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Feito hoje de manhã</p>
      <h2 id="vitrine-titulo">A vitrine de hoje</h2>
      <p>
        Sonho recheado na hora, salgado assado, bolo de pote montado no dia e café passado na hora. O que acabar, só
        amanhã.
      </p>
    </div>

    <Combo />

    <div class="filters" role="group" aria-label="Filtrar a vitrine">
      <button type="button" class="chip" data-filter="todos" aria-pressed="true">Tudo</button>
      {
        CATEGORIES.map((c) => (
          <button type="button" class="chip" data-filter={c.id} aria-pressed="false">
            {c.label}
          </button>
        ))
      }
    </div>

    <ul class="grid" role="list">
      {
        MENU.map((p, i) => (
          <li class="card" data-category={p.category} data-product={p.id} style={`view-transition-name:card-${p.id}`}>
            <div class="tile">
              <Image
                src={PHOTOS[p.id]}
                alt=""
                widths={[320, 480, 640]}
                sizes="(max-width: 600px) calc(100vw - 56px), 280px"
                class="photo"
                loading={i < 4 ? 'eager' : 'lazy'}
              />
              <span class="sticker" style={`background:${tiles[i % tiles.length]}`}>
                <Illustration art={p.art} tint={p.tint} class="card-art" />
              </span>
              <span class="in-cart" data-in-cart hidden />
              <span class="stock" data-stock hidden />
            </div>
            <div class="body">
              <h3>{p.name}</h3>
              <p class="portion">{p.portion}</p>
              {p.fornadas && (
                <p class="oven" data-fornadas={p.fornadas.join(',')}>
                  Sai do forno de {p.fornadas.length > 6 ? 'hora em hora' : p.fornadas.map((h) => `${h}h`).join(', ')}
                </p>
              )}
              <p class="desc">{p.description}</p>
              {(p.pickupOnly || p.combo === 'cafe') && (
                <ul class="perks" role="list">
                  {p.combo === 'cafe' && <li class="perk-combo">− {formatBRL(COMBO_DISCOUNT)} no combo com sonho</li>}
                  {p.pickupOnly && <li>Só para retirar no balcão</li>}
                </ul>
              )}
            </div>
            <div class="buy">
              <span class="price">{formatBRL(p.price)}</span>
              <button type="button" class="btn btn-dark add" data-add={p.id} aria-label={`Quero esse: ${p.name}`}>
                Quero esse
              </button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { batchLabel, nextBatch } from '../scripts/fornadas';

  // Next batch per card, refreshed every minute.
  const ovens = document.querySelectorAll<HTMLElement>('[data-fornadas]');
  const paintOvens = () =>
    ovens.forEach((el) => {
      const hours = el.dataset.fornadas!.split(',').map(Number);
      el.textContent = batchLabel(nextBatch(hours, new Date()));
    });
  paintOvens();
  setInterval(paintOvens, 60_000);

  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#vitrine [data-category]');

  const calm = window.matchMedia('(prefers-reduced-motion: reduce)');

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      const apply = () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cards.forEach((card) => {
          card.hidden = filter !== 'todos' && card.dataset.category !== filter;
        });
      };
      // Cards glide to their new spots instead of jumping (where supported).
      if (document.startViewTransition && !calm.matches) document.startViewTransition(apply);
      else apply();
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .chip {
    min-height: 44px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 2px solid var(--brigadeiro);
    background: transparent;
    font-weight: 700;
  }

  .chip:hover {
    background: var(--glace-2);
  }

  .chip[aria-pressed='true'] {
    background: var(--brigadeiro);
    color: var(--creme);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 14px;
    padding: 12px 12px 18px;
    background: var(--branco);
    border-radius: var(--radius-m);
    box-shadow: 0 0 0 2px var(--brigadeiro);
  }

  .tile {
    position: relative;
    aspect-ratio: 4 / 3;
    max-width: 100%;
    border-radius: 14px;
  }

  .photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    background: var(--acucar-2);
  }

  /* The illustration becomes a sticker stuck on the photo. */
  .sticker {
    position: absolute;
    left: 10px;
    bottom: -14px;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--brigadeiro);
    transform: rotate(-8deg);
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .sticker :global(.card-art) {
    width: 46px;
  }

  @media (hover: hover) {
    .card:hover .sticker {
      transform: rotate(6deg) scale(1.1);
    }
  }

  .body {
    padding-top: 8px;
  }

  .in-cart {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--creme);
    color: var(--brigadeiro);
    font-weight: 800;
    font-size: 0.875rem;
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 0 0 2px var(--brigadeiro);
    font-variant-numeric: tabular-nums;
  }

  .stock {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--branco);
    color: var(--brigadeiro);
    font-weight: 800;
    font-size: 0.8125rem;
    padding: 4px 10px;
    border-radius: 999px;
    box-shadow: 0 0 0 2px var(--brigadeiro);
  }

  .stock.out {
    background: var(--brigadeiro);
    color: var(--creme);
  }

  .card.sold-out .photo {
    filter: grayscale(0.7);
    opacity: 0.7;
  }

  .body {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-inline: 6px;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .portion {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brigadeiro-2);
  }

  /* Filled in by the script with the next batch; the server text is the fallback. */
  .oven {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 800;
    color: #9a3412;
  }

  .oven::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ea580c;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.2);
  }

  .desc {
    font-size: 0.9375rem;
    color: var(--brigadeiro-2);
    margin-top: 4px;
  }

  .perks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .perks li {
    padding: 3px 10px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1.5px var(--brigadeiro);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .perks .perk-combo {
    background: var(--creme);
    box-shadow: none;
  }

  .buy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-inline: 6px;
  }

  .buy .price {
    font-size: 1.25rem;
  }

  .add {
    min-height: 44px;
    padding-inline: 18px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .add {
      transition: transform 0.12s ease;
    }

    .add:active {
      transform: scale(0.94);
    }

    .in-cart:not([hidden]) {
      animation: tag-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Cards rise into place as they scroll in. Pure CSS: where scroll-driven
       animations are not supported, the cards are simply there. */
    @supports (animation-timeline: view()) {
      .card {
        animation: card-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(36px) scale(0.97);
    }
  }

  @keyframes tag-pop {
    from {
      transform: scale(0.4);
    }
  }

  :global(::view-transition-group(*)) {
    animation-duration: 0.35s;
    animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
  }
</style>
