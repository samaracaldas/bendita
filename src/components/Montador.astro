---
import { formatBRL } from '../data/menu';
import { MEIO_A_MEIO, SONHO_PADRAO, opcoesDo, sonhoDescricao, sonhoPreco, type Grupo } from '../data/sonho';

const steps: { grupo: Grupo; titulo: string; tipo: 'radio' | 'checkbox'; dica?: string }[] = [
  { grupo: 'massa', titulo: 'Massa', tipo: 'radio' },
  {
    grupo: 'recheio',
    titulo: 'Recheio',
    tipo: 'checkbox',
    dica: `Escolha até 2. Com dois, ele vem meio a meio (+ ${formatBRL(MEIO_A_MEIO)}).`,
  },
  { grupo: 'cobertura', titulo: 'Cobertura', tipo: 'radio' },
];

const isDefault = (grupo: Grupo, id: string) =>
  grupo === 'massa'
    ? SONHO_PADRAO.massa === id
    : grupo === 'cobertura'
      ? SONHO_PADRAO.cobertura === id
      : (SONHO_PADRAO.recheios as string[]).includes(id);

// Sugar, cinnamon and sprinkles on the dome (in the 120 × 100 illustration grid).
const dots = [
  [40, 32], [54, 26], [68, 30], [82, 28], [90, 42], [30, 44], [74, 44], [48, 42], [60, 38], [36, 36],
];
const sprinkles = [
  [38, 30, 20, '#f7b4c8'], [52, 24, -30, '#ffd23f'], [66, 32, 60, '#fff4ec'], [80, 26, -10, '#f7b4c8'],
  [88, 40, 40, '#ffd23f'], [30, 42, -50, '#fff4ec'], [72, 44, 10, '#f7b4c8'], [46, 40, 70, '#ffd23f'],
  [60, 36, -20, '#7fae5a'], [42, 48, 30, '#fff4ec'],
] as const;
---

<section id="monte" class="section monte" aria-labelledby="monte-titulo">
  <div class="wrap layout">
    <div class="intro">
      <div class="section-head">
        <p class="eyebrow">Do seu jeito</p>
        <h2 id="monte-titulo">Monte o seu sonho</h2>
        <p>Escolha a massa, até dois recheios e a cobertura. A gente recheia na hora em que você chega.</p>
      </div>

      <figure class="preview">
        <svg viewBox="0 0 120 100" aria-hidden="true" focusable="false" data-preview>
          <defs>
            <clipPath id="metade-a"><rect x="0" y="0" width="60" height="100"></rect></clipPath>
            <clipPath id="metade-b"><rect x="60" y="0" width="60" height="100"></rect></clipPath>
          </defs>
          <g stroke="#3a1d17" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round">
            <path d="M16 62c0 16 20 26 44 26s44-10 44-26z" fill="#eaa65b" data-massa></path>
            <path d="M12 60c4-8 24-13 48-13s44 5 48 13c-2 9-24 13-48 13S14 69 12 60z" stroke="none" fill="#b8732e" data-recheio-a></path>
            <path d="M12 60c4-8 24-13 48-13s44 5 48 13c-2 9-24 13-48 13S14 69 12 60z" stroke="none" fill="#ffd23f" clip-path="url(#metade-b)" data-recheio-b display="none"></path>
            <path d="M60 48v24" fill="none" stroke-width="1.6" stroke-dasharray="2 3" data-divisa display="none"></path>
            <path d="M12 60c4-8 24-13 48-13s44 5 48 13c-2 9-24 13-48 13S14 69 12 60z" fill="none"></path>
            <path d="M18 56c0-24 18-40 42-40s42 16 42 40c-10 6-24 8-42 8s-32-2-42-8z" fill="#eaa65b" data-massa></path>
          </g>
          <g data-cobertura="acucar" fill="#fff4ec">
            {dots.map(([x, y], i) => <circle cx={x} cy={y} r={i % 3 === 0 ? 2.6 : 2} />)}
          </g>
          <g data-cobertura="canela" display="none">
            {dots.map(([x, y], i) => <circle cx={x} cy={y} r={2} fill={i % 2 ? '#a0622d' : '#fff4ec'} />)}
          </g>
          <g data-cobertura="granulado" display="none">
            {sprinkles.map(([x, y, r, c]) => <rect x={x} y={y} width="5" height="1.8" rx="0.9" fill={c} transform={`rotate(${r} ${x + 2.5} ${y + 0.9})`} />)}
          </g>
        </svg>
        <figcaption class="sr-only">Prévia do sonho com as opções escolhidas.</figcaption>
      </figure>
    </div>

    <form class="builder" data-montador novalidate>
      {
        steps.map((s, i) => (
          <fieldset aria-describedby={s.dica ? `dica-${s.grupo}` : undefined}>
            <legend>
              <span class="step" aria-hidden="true">{i + 1}</span>
              {s.titulo}
            </legend>
            {s.dica && (
              <p class="dica" id={`dica-${s.grupo}`}>
                {s.dica}
              </p>
            )}
            <div class="chips">
              {opcoesDo(s.grupo).map((o) => (
                <label class="chip">
                  <input
                    type={s.tipo}
                    name={s.grupo}
                    value={o.id}
                    checked={isDefault(s.grupo, o.id)}
                    data-cor={o.cor}
                  />
                  <span class="swatch" style={`--cor:${o.cor}`} aria-hidden="true" />
                  <span class="label">{o.nome}</span>
                  {o.acrescimo > 0 && <span class="extra">+ {formatBRL(o.acrescimo)}</span>}
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }

      <div class="summary">
        <div class="summary-text">
          <p class="desc" data-montador-desc>{sonhoDescricao(SONHO_PADRAO)}</p>
          <p class="stock-note" data-montador-stock hidden></p>
        </div>
        <p class="price" data-montador-price aria-live="polite">{formatBRL(sonhoPreco(SONHO_PADRAO))}</p>
        <button type="submit" class="btn btn-dark" data-montador-add>Adicionar à sacola</button>
      </div>
    </form>
  </div>
</section>

<style>
  .monte {
    background: var(--glace-2);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  .intro {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 8px;
  }

  .preview {
    margin: 0;
    display: grid;
    place-items: center;
    aspect-ratio: 6 / 5;
    max-width: 100%;
    background: var(--branco);
    border-radius: var(--radius-l);
    box-shadow: 0 0 0 2px var(--brigadeiro), 8px 10px 0 var(--brigadeiro);
  }

  .preview svg {
    width: 78%;
    transform: rotate(-6deg);
  }

  .builder {
    display: grid;
    gap: 24px;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  legend {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    margin-bottom: 10px;
    font-family: var(--display);
    font-size: 1.5rem;
    line-height: 1;
  }

  .step {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--brigadeiro);
    color: var(--creme);
    font-family: var(--body);
    font-size: 1rem;
    font-weight: 800;
  }

  .dica {
    font-size: 0.9375rem;
    color: var(--brigadeiro-2);
    margin-top: -6px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: var(--branco);
    box-shadow: inset 0 0 0 2px rgba(58, 29, 23, 0.25);
    font-weight: 700;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .chip:hover {
    box-shadow: inset 0 0 0 2px var(--brigadeiro);
  }

  .chip:has(input:checked) {
    background: var(--brigadeiro);
    color: var(--creme);
    box-shadow: inset 0 0 0 2px var(--brigadeiro);
  }

  .chip:has(input:focus-visible) {
    outline: 3px solid var(--brigadeiro);
    outline-offset: 3px;
  }

  .chip:has(input:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .chip:has(input:disabled) input {
    cursor: not-allowed;
  }

  .swatch {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--cor);
    box-shadow: inset 0 0 0 2px var(--brigadeiro);
    flex: none;
  }

  .chip:has(input:checked) .swatch {
    box-shadow: inset 0 0 0 2px var(--creme);
  }

  .extra {
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px 20px;
    padding: 20px;
    border-radius: var(--radius-m);
    background: var(--branco);
    box-shadow: 0 0 0 2px var(--brigadeiro);
  }

  .summary-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .desc {
    font-weight: 600;
  }

  .stock-note {
    font-size: 0.875rem;
    font-weight: 800;
  }

  .summary .price {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1;
  }

  .summary .btn {
    grid-column: 1 / -1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .preview svg :global([data-massa]),
    .preview svg :global([data-recheio-a]),
    .preview svg :global([data-recheio-b]) {
      transition: fill 0.25s ease;
    }

    .preview svg.wiggle {
      animation: wiggle 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }

  @keyframes wiggle {
    40% {
      transform: rotate(-12deg) scale(1.05);
    }
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .intro {
      position: static;
    }

    .preview {
      max-width: 360px;
    }

    /* The preview scrolls away on phones: keep what changed (and the button) in view. */
    .summary {
      position: sticky;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: 5;
      box-shadow: 0 0 0 2px var(--brigadeiro), 0 8px 0 rgba(58, 29, 23, 0.18);
    }

    .desc {
      font-size: 0.9375rem;
    }
  }
</style>
