---
import { COMBO_DISCOUNT, MENU, formatBRL } from '../data/menu';
import Illustration from './Illustration.astro';

const sonhos = MENU.filter((p) => p.combo === 'sonho');
const cafes = MENU.filter((p) => p.combo === 'cafe');
const [s0, c0] = [sonhos[0], cafes[0]];
---

<!-- Shop-window card for the sonho + café combo. Prices update with the picks (see scripts/combo.ts). -->
<aside class="combo" data-combo aria-labelledby="combo-titulo">
  <div class="art" aria-hidden="true">
    <Illustration art="sonho" tint={s0.tint} class="art-sonho" />
    <Illustration art="xicara" tint={c0.tint} class="art-cafe" />
  </div>

  <div class="copy">
    <p class="tag">Combo da manhã</p>
    <h3 id="combo-titulo">Sonho + café, {formatBRL(COMBO_DISCOUNT)} a menos</h3>
    <p>
      Qualquer sonho com café coado, pingado ou cappuccino. Vale para cada par na sacola, inclusive o sonho que você
      monta. Só para retirar no balcão.
    </p>
  </div>

  <form class="pick" data-combo-form>
    <label>
      <span>Sonho</span>
      <select name="sonho" data-combo-sonho>
        {sonhos.map((p) => <option value={p.id} data-price={p.price}>{p.name.replace('Sonho de ', '').replace(/^./, (c) => c.toUpperCase())}</option>)}
      </select>
    </label>
    <label>
      <span>Café</span>
      <select name="cafe" data-combo-cafe>
        {cafes.map((p) => <option value={p.id} data-price={p.price}>{p.name}</option>)}
      </select>
    </label>
    <p class="price" aria-live="polite">
      <s data-combo-de>{formatBRL(s0.price + c0.price)}</s>
      <strong data-combo-por>{formatBRL(s0.price + c0.price - COMBO_DISCOUNT)}</strong>
    </p>
    <button type="submit" class="btn btn-dark">Quero o combo</button>
  </form>
</aside>

<style>
  .combo {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    margin-bottom: 28px;
    padding: clamp(18px, 3vw, 28px);
    background: var(--creme);
    border-radius: var(--radius-l);
    box-shadow: 0 0 0 3px var(--brigadeiro), 8px 10px 0 var(--brigadeiro);
  }

  .art {
    position: relative;
    width: 150px;
    height: 110px;
  }

  .art :global(.art-sonho) {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100px;
    transform: rotate(-8deg);
  }

  .art :global(.art-cafe) {
    position: absolute;
    right: 0;
    top: 0;
    width: 76px;
    transform: rotate(8deg);
  }

  .tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--brigadeiro);
    color: var(--creme);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin-top: 8px;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    line-height: 1.05;
  }

  .copy p:last-child {
    margin-top: 6px;
    max-width: 52ch;
  }

  .pick {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    min-width: 280px;
  }

  label {
    display: grid;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 800;
  }

  select {
    min-height: 44px;
    padding: 0 10px;
    border: 2px solid var(--brigadeiro);
    border-radius: 12px;
    background: var(--branco);
    font: inherit;
    font-weight: 600;
  }

  .price {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .price s {
    color: var(--brigadeiro-2);
  }

  .price strong {
    font-size: 1.5rem;
  }

  .pick .btn {
    grid-column: 1 / -1;
  }

  @media (max-width: 900px) {
    .combo {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .pick {
      grid-column: 1 / -1;
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .combo {
      grid-template-columns: 1fr;
    }

    .art {
      display: none;
    }
  }
</style>
