---
interface Props {
  /** Pages other than the shop link back to its sections. */
  home?: boolean;
  /** Path of the current page, to mark its link. */
  current?: string;
}

const { home = true, current } = Astro.props;
const base = home ? '' : '/';
const links = [
  { href: `${base}#vitrine`, label: 'Vitrine' },
  { href: `${base}#monte`, label: 'Monte o seu' },
  { href: `${base}#festa`, label: 'Festa' },
  { href: '/sobre', label: 'Sobre' },
  { href: `${base}#visite`, label: 'Visite' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href={home ? '#topo' : '/'} class="logo" aria-label="Bendita, voltar ao início">bendita</a>

    <nav aria-label="Principal">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="order-link" data-last-order hidden>Seu pedido</a>

    <button type="button" class="cart-btn" data-cart-open aria-haspopup="dialog" aria-controls="sacola">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z" />
        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
      </svg>
      <span class="cart-label">Sacola</span>
      <span class="cart-count" data-cart-count aria-hidden="true">0</span>
      <span class="sr-only" data-cart-count-sr>, vazia</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--acucar);
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s ease;
  }

  :global(body)::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: env(safe-area-inset-top, 0px);
    z-index: 21;
    background: var(--acucar);
  }

  :global(.scrolled) .site-header {
    border-bottom-color: var(--brigadeiro);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .logo {
    font-family: var(--display);
    font-size: 2rem;
    line-height: 1;
    text-decoration: none;
    position: relative;
    padding-right: 12px;
  }

  /* The sprinkle on the logo. */
  .logo::after {
    content: '';
    position: absolute;
    right: 0;
    top: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--glace);
    box-shadow: 0 0 0 2px var(--brigadeiro);
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Five links: tighten before they would wrap. */
  @media (max-width: 1000px) {
    nav ul {
      gap: 2px;
    }

    nav a {
      padding: 8px 9px;
      font-size: 0.9375rem;
    }
  }

  nav a:hover {
    background: var(--glace-2);
  }

  nav a[aria-current='page'] {
    background: var(--brigadeiro);
    color: var(--creme);
  }

  .cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 10px 8px 16px;
    border: 0;
    border-radius: 999px;
    background: var(--brigadeiro);
    color: var(--creme);
    font-weight: 700;
  }

  /* Shown when this device placed an order in the last two days. */
  .order-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 2px var(--brigadeiro);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .order-link[hidden] {
    display: none;
  }

  .order-link:hover {
    background: var(--creme);
  }

  .cart-btn:hover {
    background: #4d2820;
  }

  .cart-count {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding-inline: 6px;
    border-radius: 999px;
    background: var(--creme);
    color: var(--brigadeiro);
    font-variant-numeric: tabular-nums;
  }

  .cart-count.bump {
    animation: bump 0.35s ease;
  }

  @keyframes bump {
    40% {
      transform: scale(1.3);
    }
  }

  @media (max-width: 760px) {
    nav {
      display: none;
    }

    .order-link,
    .cart-btn {
      margin-left: auto;
    }

    .order-link:not([hidden]) + .cart-btn {
      margin-left: 0;
    }

    .bar {
      gap: 10px;
    }

    .order-link {
      padding: 8px 12px;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 360px) {
    .cart-label {
      display: none;
    }
  }
</style>
